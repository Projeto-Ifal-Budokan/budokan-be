# Copie para .env e preencha. O .env está no .gitignore — nunca commitar valores reais.
# Gerar segredos:  openssl rand -hex 32     (JWT_SECRET)
#                 openssl rand -hex 24     (senhas do MySQL)

NODE_ENV=develop
PORT=8000

# Usado pelo docker-compose para criar o MySQL local
MYSQL_ROOT_PASSWORD=tobemodified
MYSQL_DATABASE=budokan-db
MYSQL_USER=budokan
MYSQL_PASSWORD=tobemodified

# Do container para o container "mysql"; DATABASE_URL vale para rodar fora do docker
DATABASE_URL=mysql://<user>:<password>@<host>:<port>/<database>
DATABASE_URL_FROM_CONTAINER=mysql://budokan:<password>@mysql:3306/budokan-db

JWT_SECRET=

# Origens liberadas no CORS e links gerados pelo app
DEV_URL=http://localhost:3000
PROD_URL=https://budokanryu.com.br

# E-mail (rotacionar as credenciais que estiveram no git)
ETHEREAL_USER=seu_usuario@ethereal.email
ETHEREAL_PASS=sua_senha
GMAIL_USER=seu_usuario@gmail.com
GMAIL_APP_PASSWORD=sua_senha_de_app

# Pasta onde o compose monta uploads/ e mysql/ (default: /home/budokan/budokan-data)
# DATA_DIR=/home/budokan/budokan-data

# Senhas das contas criadas por pnpm seed.
# Em NODE_ENV=production sem estas variaveis o seed aborta antes de escrever.
# Fora de producao caem nos defaults historicos (admin123/instructor123/student123).
SEED_ADMIN_PASSWORD=
SEED_INSTRUCTOR_PASSWORD=
SEED_STUDENT_PASSWORD=

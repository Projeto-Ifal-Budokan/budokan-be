table tb_attendances {
  id "bigint unsigned" [pk, not null, increment]
  id_matriculation "bigint unsigned" [not null]
  id_session "bigint unsigned" [not null]
  status enum('present','absent') [not null, default: 'absent']
  created_at timestamp [not null, default: `(now())`]
  updated_at timestamp
}

table tb_sessions {
  id "bigint unsigned" [pk, not null, increment]
  id_instructor_discipline "bigint unsigned" [not null]
  id_discipline "bigint unsigned" [not null]
  date date [not null]
  starting_time time [not null]
  ending_time time [not null]
  is_last_session_of_day boolean [not null, default: false]
  created_at timestamp [not null, default: `(now())`]
  updated_at timestamp
}

table tb_daily_absences {
  id "bigint unsigned" [pk, not null, increment]
  id_matriculation "bigint unsigned" [not null]
  date date [not null]
  justification enum('medical','personal','professional','weather','transport','family','academic','technical','emergency','other')
  justification_description varchar(255)
  created_at timestamp [not null, default: `(now())`]
  updated_at timestamp
}

table tb_achievments {
  id "bigint unsigned" [pk, not null, increment]
  id_practitioner "bigint unsigned"
  id_discipline "bigint unsigned"
  title varchar(100) [not null]
  description varchar(255) [not null]
  achievement_date date [not null]
  created_at timestamp [not null, default: `(now())`]
  updated_at timestamp
}

table tb_disciplines {
  id "bigint unsigned" [pk, not null, increment]
  name varchar(100) [not null]
  description varchar(100) [not null]
  status enum('active','inactive','suspended') [not null, default: 'active']
  created_at timestamp [not null, default: `(now())`]
  updated_at timestamp
}

table tb_exams {
  id "bigint unsigned" [pk, not null, increment]
  id_instructor "bigint unsigned" [not null]
  id_student "bigint unsigned" [not null]
  id_previous_rank "bigint unsigned"
  id_next_rank "bigint unsigned"
  id_discipline "bigint unsigned" [not null]
  date date [not null]
  exam_observation varchar(255)
  status enum('scheduled','approved','failed') [not null, default: 'scheduled']
  created_at timestamp [not null, default: `(now())`]
  updated_at timestamp
}

table tb_ranks {
  id "bigint unsigned" [pk, not null, increment]
  id_discipline "bigint unsigned" [not null]
  name varchar(100) [not null]
  description varchar(100) [not null]
  created_at timestamp [not null, default: `(now())`]
  updated_at timestamp
}

table tb_training_schedules {
  id "bigint unsigned" [pk, not null, increment]
  id_discipline "bigint unsigned"
  weekday enum('monday','tuesday','wednesday','thursday','friday','saturday','sunday') [not null]
  start_time time [not null]
  end_time time [not null]
  created_at timestamp [not null, default: `(now())`]
  updated_at timestamp
}

table tb_billing_cycles {
  id "bigint unsigned" [pk, not null, increment]
  id_instructor "bigint unsigned" [not null]
  id_discipline "bigint unsigned" [not null]
  month int [not null]
  year int [not null]
  due_date date [not null]
  amount decimal(10,2) [not null]
  description varchar(255)
  created_at timestamp [not null, default: `(now())`]
  updated_at timestamp
}

table tb_payments {
  id "bigint unsigned" [pk, not null, increment]
  id_billing_cycle "bigint unsigned" [not null]
  id_matriculation "bigint unsigned" [not null]
  payment_date date [not null]
  status enum('paid','pending','late') [not null, default: 'pending']
  method enum('pix','cash','credit','debit')
  created_at timestamp [not null, default: `(now())`]
  updated_at timestamp
}

table tb_instructor_disciplines {
  id "bigint unsigned" [pk, not null, increment]
  id_instructor "bigint unsigned" [not null]
  id_discipline "bigint unsigned" [not null]
  id_rank "bigint unsigned"
  status enum('active','inactive','suspended') [not null, default: 'active']
  activated_by "bigint unsigned" [default: `null`]
  inactivated_by "bigint unsigned" [default: `null`]
  created_at timestamp [not null, default: `(now())`]
  updated_at timestamp
}

table tb_instructors {
  id_practitioner "bigint unsigned" [pk, not null, increment]
  created_at timestamp [not null, default: `(now())`]
  updated_at timestamp
}

table tb_matriculations {
  id "bigint unsigned" [pk, not null, increment]
  id_student "bigint unsigned" [not null]
  id_discipline "bigint unsigned" [not null]
  id_rank "bigint unsigned"
  status enum('active','inactive','suspended') [not null, default: 'active']
  activated_by "bigint unsigned"
  inactivated_by "bigint unsigned"
  is_payment_exempt enum('Y','N') [not null, default: 'N']
  created_at timestamp [not null, default: `(now())`]
  updated_at timestamp
}

table tb_pix_keys {
  id "bigint unsigned" [pk, not null, increment]
  id_instructor "bigint unsigned" [not null]
  type enum('email','cpf','phone','randomKey') [not null]
  key varchar(100) [not null, unique]
  description varchar(100)
  created_at timestamp [not null, default: `(now())`]
  updated_at timestamp
}

table tb_practitioner_contacts {
  id "bigint unsigned" [pk, not null, increment]
  id_practitioner "bigint unsigned" [not null]
  phone varchar(20)
  relationship varchar(100) [not null]
  created_at timestamp [not null, default: `(now())`]
  updated_at timestamp
}

table tb_practitioners {
  id_user "bigint unsigned" [pk, not null, increment]
  health_observations varchar(255)
  created_at timestamp [not null, default: `(now())`]
  updated_at timestamp
}

table tb_students {
  id_practitioner "bigint unsigned" [pk, not null, increment]
  created_at timestamp [not null, default: `(now())`]
  updated_at timestamp
}

table tb_users {
  id "bigint unsigned" [pk, not null, increment]
  first_name varchar(100) [not null]
  surname varchar(100) [not null]
  phone varchar(20) [not null]
  birth_date datetime [not null]
  email varchar(150) [not null, unique]
  password varchar(255) [not null]
  profile_image_url varchar(500)
  status enum('active','inactive','suspended') [not null, default: 'inactive']
  created_at timestamp [not null, default: `(now())`]
  updated_at timestamp
}

table tb_roles {
  id "bigint unsigned" [pk, not null, increment]
  name varchar(100) [not null, unique]
  description varchar(255) [not null]
  created_at timestamp [not null, default: `(now())`]
  updated_at timestamp
}

table tb_user_roles {
  id "bigint unsigned" [pk, not null, increment]
  id_role "bigint unsigned" [not null]
  id_user "bigint unsigned" [not null]
  created_at timestamp [not null, default: `(now())`]
  updated_at timestamp
}

table tb_privileges {
  id "bigint unsigned" [pk, not null, increment]
  name varchar(100) [not null, unique]
  description varchar(255) [not null]
  created_at timestamp [not null, default: `(now())`]
  updated_at timestamp
}

table tb_role_privileges {
  id "bigint unsigned" [pk, not null, increment]
  id_role "bigint unsigned" [not null]
  id_privilege "bigint unsigned" [not null]
  created_at timestamp [not null, default: `(now())`]
  updated_at timestamp
}

ref: tb_attendances.id_matriculation > tb_matriculations.id

ref: tb_attendances.id_session > tb_sessions.id

ref: tb_sessions.id_instructor_discipline > tb_instructor_disciplines.id

ref: tb_sessions.id_discipline > tb_disciplines.id

ref: tb_daily_absences.id_matriculation - tb_matriculations.id

ref: tb_achievments.id_practitioner - tb_practitioners.id_user

ref: tb_achievments.id_discipline - tb_disciplines.id

ref: tb_exams.id_instructor - tb_instructors.id_practitioner

ref: tb_exams.id_student - tb_students.id_practitioner

ref: tb_exams.id_previous_rank > tb_ranks.id

ref: tb_exams.id_next_rank > tb_ranks.id

ref: tb_exams.id_discipline > tb_disciplines.id

ref: tb_ranks.id_discipline > tb_disciplines.id

ref: tb_training_schedules.id_discipline > tb_disciplines.id

ref: tb_billing_cycles.id_instructor - tb_instructors.id_practitioner

ref: tb_billing_cycles.id_discipline - tb_disciplines.id

ref: tb_payments.id_billing_cycle > tb_billing_cycles.id

ref: tb_payments.id_matriculation - tb_matriculations.id

ref: tb_instructor_disciplines.id_instructor - tb_instructors.id_practitioner

ref: tb_instructor_disciplines.id_discipline > tb_disciplines.id

ref: tb_instructor_disciplines.id_rank > tb_ranks.id

ref: tb_instructor_disciplines.inactivated_by - tb_users.id

ref: tb_instructors.id_practitioner - tb_practitioners.id_user

ref: tb_matriculations.inactivated_by - tb_users.id

ref: tb_matriculations.id_student > tb_students.id_practitioner

ref: tb_matriculations.id_discipline > tb_disciplines.id

ref: tb_matriculations.id_rank > tb_ranks.id

ref: tb_pix_keys.id_instructor > tb_instructors.id_practitioner

ref: tb_practitioner_contacts.id_practitioner > tb_practitioners.id_user

ref: tb_practitioners.id_user - tb_users.id

ref: tb_students.id_practitioner - tb_practitioners.id_user

ref: tb_user_roles.id_role > tb_roles.id

ref: tb_user_roles.id_user - tb_users.id

ref: tb_role_privileges.id_role > tb_roles.id

ref: tb_role_privileges.id_privilege > tb_privileges.id